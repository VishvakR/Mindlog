        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mindlog_statemachine_group_commit_entries_sum[1m])) / sum(rate(mindlog_statemachine_group_commit_entries_count[1m]))",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Process",
      "collapsed": false,
      "gridPos": {
        "x": 0,
