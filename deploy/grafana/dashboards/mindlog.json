          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mindlog_statemachine_apply_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Proposal queue",
      "description": "BUSY is returned above limits.maxPendingProposals",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
