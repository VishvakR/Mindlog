{
  "name": "mindlog",
  "version": "0.0.0",
  "private": true,
  "description": "Redis-compatible, Raft-replicated database and long-term memory for AI agents",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint": "pnpm lint:eslint && pnpm lint:cycles && pnpm format:check && pnpm --filter @mindlog/web lint",
    "test": "vitest run && pnpm --filter @mindlog/web test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "lint:commits": "commitlint --from $(git rev-list --max-parents=0 HEAD) --to HEAD",
    "proto:lint": "buf lint",
    "proto:gen": "scripts/gen-proto.sh",
    "proto:breaking": "buf breaking --against \".git#branch=main\"",
    "build": "tsc -b && pnpm --filter @mindlog/web build",
    "typecheck": "tsc -b tsconfig.check.json && pnpm --filter @mindlog/web typecheck",
    "lint:cycles": "madge --circular packages",
    "fuzz:resp": "FUZZ_RUNS=${FUZZ_RUNS:-200000} vitest run --testTimeout=3600000 packages/adapter-resp/test/fuzz",
    "dev": "pnpm --filter @mindlog/web build && tsc -b packages/server && node packages/server/dist/bin.js --single-node",
    "sim": "SIM_SEEDS=${SIM_SEEDS:-1000} vitest run test/sim/sim.test.ts",
    "test:durability": "CRASH_ITERATIONS=${CRASH_ITERATIONS:-50} vitest run test/integration/crash-durability.test.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@mindlog/cache": "workspace:*",
    "@mindlog/core": "workspace:*",
    "@mindlog/eventbus": "workspace:*",
    "@mindlog/index-text": "workspace:*",
    "@mindlog/jobs": "workspace:*",
    "@mindlog/kv": "workspace:*",
    "@mindlog/memory": "workspace:*",
    "@mindlog/models-client": "workspace:*",
    "@mindlog/multiraft": "workspace:*",
    "@mindlog/pd": "workspace:*",
    "@mindlog/proto": "workspace:*",
    "@mindlog/raft": "workspace:*",
    "@mindlog/server": "workspace:*",
    "@mindlog/services": "workspace:*",
    "@mindlog/statemachine": "workspace:*",
    "@mindlog/storage": "workspace:*",
    "@mindlog/transport": "workspace:*",
    "@mindlog/txn": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "ioredis": "6.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
