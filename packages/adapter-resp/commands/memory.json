{
  "MEM.ADD": {
    "summary": "Remembers text in a scope: facts are extracted, embedded and indexed (PLAN 12.3).",
    "complexity": "O(N) in the text length",
    "group": "memory",
    "since": "0.5.0",
    "arity": -3,
    "command_flags": ["WRITE"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "text", "type": "string" },
      { "name": "kind", "type": "string", "token": "KIND", "optional": true },
      { "name": "source", "type": "string", "token": "SOURCE", "optional": true },
      { "name": "valid_from", "type": "string", "token": "VALID_FROM", "optional": true },
      { "name": "valid_to", "type": "string", "token": "VALID_TO", "optional": true },
      { "name": "branch", "type": "string", "token": "BRANCH", "optional": true },
      { "name": "async", "type": "pure-token", "token": "ASYNC", "optional": true }
    ]
  },
  "MEM.SEARCH": {
    "summary": "Recalls the memories of a scope most relevant to a query (PLAN 12.4).",
    "complexity": "O(N) in the scope's memories",
    "group": "memory",
    "since": "0.5.0",
    "arity": -3,
    "command_flags": ["READONLY"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "query", "type": "string" },
      { "name": "k", "type": "integer", "token": "K", "optional": true },
      { "name": "budget", "type": "integer", "token": "BUDGET", "optional": true },
      { "name": "inherit", "type": "pure-token", "token": "INHERIT", "optional": true },
      { "name": "recipe", "type": "string", "token": "RECIPE", "optional": true },
      { "name": "asof", "type": "string", "token": "ASOF", "optional": true },
      { "name": "valid_at", "type": "string", "token": "VALID_AT", "optional": true },
      { "name": "branch", "type": "string", "token": "BRANCH", "optional": true }
    ]
  },
  "MEM.PACK": {
    "summary": "Packs the memories most relevant to a query into a token budget, grouped by kind (PLAN 13.6).",
    "complexity": "O(N) in the scope's memories",
    "group": "memory",
    "since": "0.6.0",
    "arity": -3,
    "command_flags": ["READONLY"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "query", "type": "string" },
      { "name": "budget", "type": "integer", "token": "BUDGET", "optional": true },
      { "name": "inherit", "type": "pure-token", "token": "INHERIT", "optional": true },
      { "name": "recipe", "type": "string", "token": "RECIPE", "optional": true },
      { "name": "asof", "type": "string", "token": "ASOF", "optional": true },
      { "name": "valid_at", "type": "string", "token": "VALID_AT", "optional": true },
      { "name": "branch", "type": "string", "token": "BRANCH", "optional": true }
    ]
  },
  "MEM.GET": {
    "summary": "Returns one memory of a scope, or nil.",
    "complexity": "O(1)",
    "group": "memory",
    "since": "0.5.0",
    "arity": -3,
    "command_flags": ["READONLY"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "id", "type": "string" },
      { "name": "asof", "type": "string", "token": "ASOF", "optional": true },
      { "name": "branch", "type": "string", "token": "BRANCH", "optional": true }
    ]
  },
  "MEM.FORGET": {
    "summary": "Forgets memories of a scope, or with SOURCE ref everything from that source and derived from it (append-only: history is kept); returns how many.",
    "complexity": "O(N) in the ids",
    "group": "memory",
    "since": "0.5.0",
    "arity": -3,
    "command_flags": ["WRITE"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "branch", "type": "string", "token": "BRANCH", "optional": true },
      { "name": "id", "type": "string", "multiple": true }
    ]
  },
  "MEM.HISTORY": {
    "summary": "Returns the stored versions of a memory, newest first.",
    "complexity": "O(N) in its versions",
    "group": "memory",
    "since": "0.5.0",
    "arity": 3,
    "command_flags": ["READONLY"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "id", "type": "string" }
    ]
  },
  "MEM.CONFLICTS": {
    "summary": "Lists the conflicts of a scope: open ones, or all with ALL (PLAN 13.2).",
    "complexity": "O(N) in the conflicts returned",
    "group": "memory",
    "since": "0.7.0",
    "arity": -2,
    "command_flags": ["READONLY"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "all", "type": "pure-token", "token": "ALL", "optional": true },
      { "name": "limit", "type": "integer", "token": "LIMIT", "optional": true },
      { "name": "after", "type": "string", "token": "AFTER", "optional": true }
    ]
  },
  "MEM.RESOLVE": {
    "summary": "Resolves a conflict: keeps a, b or both; the loser's validity ends (PLAN 13.2).",
    "complexity": "O(1)",
    "group": "memory",
    "since": "0.7.0",
    "arity": -5,
    "command_flags": ["WRITE"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "id", "type": "string" },
      { "name": "keep", "type": "string", "token": "KEEP" },
      { "name": "valid_from", "type": "string", "token": "VALID_FROM", "optional": true }
    ]
  },
  "MEM.TRUST": {
    "summary": "Sets the trust of memories: verified, normal or quarantined (PLAN 13.4).",
    "complexity": "O(N) in the ids",
    "group": "memory",
    "since": "0.7.0",
    "arity": -4,
    "command_flags": ["WRITE"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "trust", "type": "string" },
      { "name": "branch", "type": "string", "token": "BRANCH", "optional": true },
      { "name": "id", "type": "string", "multiple": true }
    ]
  },
  "MEM.BRANCH": {
    "summary": "Creates a branch of a scope that reads main as of now (PLAN 13.1).",
    "complexity": "O(1)",
    "group": "memory",
    "since": "0.7.0",
    "arity": 3,
    "command_flags": ["WRITE"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "name", "type": "string" }
    ]
  },
  "MEM.BRANCHES": {
    "summary": "Lists the branches of a scope, open and closed.",
    "complexity": "O(N) in the branches",
    "group": "memory",
    "since": "0.7.0",
    "arity": 2,
    "command_flags": ["READONLY"],
    "arguments": [{ "name": "scope", "type": "string" }]
  },
  "MEM.DIFF": {
    "summary": "Shows what a branch added, forgot and changed relative to main at its fork.",
    "complexity": "O(N) in the branch's memories",
    "group": "memory",
    "since": "0.7.0",
    "arity": 3,
    "command_flags": ["READONLY"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "name", "type": "string" }
    ]
  },
  "MEM.MERGE": {
    "summary": "Merges a branch into main; POLICY says what contradicting facts do (PLAN 13.1).",
    "complexity": "O(N) in the branch's memories",
    "group": "memory",
    "since": "0.7.0",
    "arity": -3,
    "command_flags": ["WRITE"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "name", "type": "string" },
      { "name": "policy", "type": "string", "token": "POLICY", "optional": true }
    ]
  },
  "MEM.DROP": {
    "summary": "Drops a branch and the memories written on it.",
    "complexity": "O(N) in the branch's memories",
    "group": "memory",
    "since": "0.7.0",
    "arity": 3,
    "command_flags": ["WRITE"],
    "arguments": [
      { "name": "scope", "type": "string" },
      { "name": "name", "type": "string" }
    ]
  }
}
