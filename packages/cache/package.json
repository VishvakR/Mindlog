{
  "name": "@mindlog/cache",
  "version": "0.0.0",
  "private": true,
  "description": "Memory-aware semantic cache: replicated entries in the scope's range, dependency invalidation inside apply, L1/L2 lookup with a pluggable similarity evaluator",
  "type": "module",
  "exports": {
    ".": {
      "@mindlog/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/cache/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@mindlog/core": "workspace:*",
    "@mindlog/models-client": "workspace:*",
    "@mindlog/proto": "workspace:*",
    "@mindlog/statemachine": "workspace:*",
    "@mindlog/storage": "workspace:*"
  },
  "devDependencies": {
    "@mindlog/eventbus": "workspace:*",
    "@mindlog/multiraft": "workspace:*"
  }
}
