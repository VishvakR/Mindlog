{
  "name": "@mindlog/router",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Request routing: finds the range of a key, runs on the local leader or forwards to its node",
  "type": "module",
  "exports": {
    ".": {
      "@mindlog/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/router/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@mindlog/core": "workspace:*",
    "@mindlog/kv": "workspace:*",
    "@mindlog/multiraft": "workspace:*",
    "@mindlog/proto": "workspace:*",
    "@mindlog/services": "workspace:*",
    "@mindlog/statemachine": "workspace:*",
    "@mindlog/storage": "workspace:*",
    "@mindlog/transport": "workspace:*"
  }
}
