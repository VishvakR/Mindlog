{
  "name": "@mindlog/server",
  "version": "0.0.0",
  "private": true,
  "description": "Composition root: configuration, wiring, lifecycle and the mindlog-server CLI",
  "type": "module",
  "exports": {
    ".": {
      "@mindlog/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mindlog-server": "./dist/bin.js",
    "mindlog-maelstrom": "./dist/maelstrom/main.js"
  },
  "files": [
    "dist",
    "dashboard"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/server/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@mindlog/adapter-http": "workspace:*",
    "@mindlog/adapter-resp": "workspace:*",
    "@mindlog/core": "workspace:*",
    "@mindlog/eventbus": "workspace:*",
    "@mindlog/kv": "workspace:*",
    "@mindlog/multiraft": "workspace:*",
    "@mindlog/pd": "workspace:*",
    "@mindlog/proto": "workspace:*",
    "@mindlog/router": "workspace:*",
    "@mindlog/services": "workspace:*",
    "@mindlog/statemachine": "workspace:*",
    "@mindlog/storage": "workspace:*",
    "@mindlog/transport": "workspace:*"
  }
}
