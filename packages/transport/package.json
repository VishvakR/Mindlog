{
  "name": "@mindlog/transport",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Raft transport between nodes over Connect (gRPC on HTTP/2)",
  "type": "module",
  "exports": {
    ".": {
      "@mindlog/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/transport/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@mindlog/core": "workspace:*",
    "@mindlog/multiraft": "workspace:*",
    "@mindlog/proto": "workspace:*"
  }
}
